MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1206051784}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f0eefde916e635f469a153d4ba4c2a56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  characterProfiles:
  - characterImage: {fileID: 521899597}
    characterName: "\u53F8\u5100"
  - characterImage: {fileID: 1269527413}
    characterName: "\u827E\u745E\u7D72"
  - characterImage: {fileID: 1881221719}
    characterName: "\u5B78\u52D9\u4E3B\u4EFB"
  dialogueLines:
  - speakerImage: {fileID: 0}
    overrideName: "\u53F8\u5100"
    content: "\u63A5\u4E0B\u4F86\u6709\u8ACB\u9577\u5B98\u4F86\u8CD3\u81F4\u8A5E"
  - speakerImage: {fileID: 0}
    overrideName: 
    content: "\u53F0\u4E0B\u7684\u7D30\u5FAE\u8B1B\u8A71\u8072\u5B8C\u5168\u505C\u6B62\uFF0C\u9019\u662F\u53EF\u9810\u671F\u5230\u7684\u4E8B\u60C5\uFF0C\u7562\u7ADF\u5C0D\u65B9\u662F..."
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u54C8\u56C9\u5404\u4F4D\uFF0C\u5927\u5BB6\u597D\u554A\u3002"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u4ECA\u5929\u662F\u8ECD\u5B98\u5B78\u9662\u7684\u958B\u5B78\u5178\u79AE\u3002"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u6211\u4F5C\u70BA\u6211\u5011\u738B\u570B\u7684\u5927\u5C07\u8ECD\u3001\u8CB4\u6821\u7684\u7279\u8058\u6307\u5C0E\u8001\u5E2B\u4EE5\u53CA\u5404\u4F4D\u7684\u5B78\u59D0"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u5F88\u69AE\u5E78\u88AB\u9080\u8ACB\u524D\u4F86\u795D\u8CC0\u3002"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u5197\u9577\u53C8\u6C89\u91CD\u7684\u8A71\u984C\u5C31\u4E0D\u518D\u63D0\u4E86"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u53EA\u5E0C\u671B\u5404\u4F4D\u65B0\u79C0\u80FD\u5920\u6210\u529F\u7562\u696D\uFF0C\u4E26\u6210\u529F\u5728\u6230\u5834\u4E0A\u6D3B\u4E0B\u4F86"
  - speakerImage: {fileID: 1269527413}
    overrideName: 
    content: "\u8B1D\u8B1D\u5404\u4F4D\uFF01"
  - speakerImage: {fileID: 0}
    overrideName: 
    content: "\u96D6\u7136\u81F4\u8A5E\u76F8\u7576\u7C21\u77ED\uFF0C\u4F46\u4F9D\u7136\u6210\u70BA\u638C\u8072\u6700\u71B1\u70C8\u7684\u8CB4\u8CD3\u3002"
  - speakerImage: {fileID: 0}
    overrideName: 
    content: "\u4E0D\u53EA\u662F\u56E0\u70BA\u5927\u5BB6\u90FD\u80FD\u5C11\u7AD95\u5206\u9418\uFF0C\u66F4\u662F\u56E0\u70BA\u5979\u53EF\u662F\u6211\u5011\u738B\u570B\u7684\u50B3\u5947\u3002 "
  - speakerImage: {fileID: 0}
    overrideName: 
    content: "\u7136\u800C\uFF0C\u4ECA\u5929\u7684\u958B\u5B78\u5178\u79AE\u9084\u6709\u65B0\u7684\u6771\u897F\u3002 "
  - speakerImage: {fileID: 0}
    overrideName: "\u5B78\u52D9\u4E3B\u4EFB"
    content: "\u5927\u5BB6\u597D\uFF0C\u6211\u662F\u5B78\u52D9\u4E3B\u4EFB\u3002"
  - speakerImage: {fileID: 0}
    overrideName: "\u5B78\u52D9\u4E3B\u4EFB"
    content: "\u6211\u5011\u4ECA\u5929\u5BA3\u5E03\uFF0C\u5C07\u6703\u6709\u65B0\u5F0F\u7684\u8A13\u7DF4\u88DD\u7F6E\u4F9B\u5927\u5BB6\u4F7F\u7528\u3002"
  - speakerImage: {fileID: 0}
    overrideName: "\u5B78\u52D9\u4E3B\u4EFB"
    content: "\u5F9E\u9019\u5B78\u671F\u958B\u59CB\uFF0C\u5927\u5BB6\u90FD\u80FD\u5920\u5B9A\u6642\u4F7F\u7528\u9019\u500B\u88DD\u7F6E"
  - speakerImage: {fileID: 0}
    overrideName: "\u5B78\u52D9\u4E3B\u4EFB"
