  - speakerImage: {fileID: 0}
    overrideName: "\u6280\u8853\u4EBA\u54E1"
    content: "\u8EBA\u5230\u6C99\u767C\u4E0A\uFF0C\u7136\u5F8C\u628A\u9019\u500B\u6234\u4E0A\u3002"
  - speakerImage: {fileID: 89069837}
    overrideName: 
    content: "\u6211\u53EF\u4EE5\u554F\u4E00\u4E0B\u5B83\u7684\u904B\u4F5C\u908F\u8F2F\u55CE\uFF1F"
  - speakerImage: {fileID: 0}
    overrideName: "\u6280\u8853\u4EBA\u54E1"
    content: "\u53CD\u6B63\u5C31\u662F\u72C0\u7F6E\u5167\u6709\u8A31\u591A\u5C0F\u7684\u9B54\u6CD5\u9663\uFF0C\u4ED6\u5011\u5171\u540C\u904B\u4F5C\u5C31\u80FD\u9054\u6210\u76EE\u6A19\u3002"
  - speakerImage: {fileID: 0}
    overrideName: "\u6280\u8853\u4EBA\u54E1"
    content: "\u8B1B\u66F4\u7D30\u4F60\u4E5F\u807D\u4E0D\u61C2\uFF0C\u9084\u662F\u5148\u5FEB\u9EDE\u5427\uFF0C\u5F8C\u9762\u9084\u6709\u4E00\u5806\u4EBA\u3002"
  - speakerImage: {fileID: 0}
    overrideName: 
    content: "\u5C07\u8EAB\u9AD4\u7684\u91CD\u91CF\u4EA4\u4ED8\u7D66\u6DF1\u539A\u7684\u6C99\u767C\u6905\uFF0C\u6234\u4E0A\u88DD\u7F6E\uFF0C\u6A21\u64EC\u5BA4\u89D2\u843D\u90A3\u4E0D\u523A\u773C\u7684\u6696\u5149\u4E5F\u88AB\u5B8C\u5168\u7684\u9ED1\u6697\u53D6\u4EE3\u3002"
  - speakerImage: {fileID: 0}
    overrideName: "\u6280\u8853\u4EBA\u54E1"
    content: "\u9589\u4E0A\u773C\u775B\uFF0C\u60F3\u50CF\u81EA\u5DF1\u6B63\u5728\u6F02\u6D41\uFF0C\u7136\u5F8C......\u5230\u4E86\u3002\n"
